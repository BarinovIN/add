#Использовать cmdline
#Использовать logos
#Использовать "."

Перем Лог;

Процедура ВывестиСправку()
    
    Сообщить("Скрипт для установки версии в соответствии с releaseCheck.md");
    Сообщить(" ");
    Сообщить("Использование:");
    Сообщить("    set-version.os <версия>");
    Сообщить(" ");
    Сообщить("Параметры:");
    Сообщить("    <версия>              Версия в формате Semantic Versioning (W.X.Y или W.X.Y.Z)");
    Сообщить("                          Например: 1.0.0, 6.9.6, 7.0.0.1");
    Сообщить("    --help                Показать эту справку");
    Сообщить(" ");
    Сообщить("Описание:");
    Сообщить("    Шаг 1: Обновляет версию в Ext/ObjectModule.bsl файлах в папке epf/");
    Сообщить("           (bddRunner и xddTestRunner)");
    Сообщить("    Шаг 2: Обновляет <Version> в XML конфигураций в папке lib/cf");
    Сообщить("    Шаг 3: Обновляет <Version> в XML расширений в папке lib/cfe");
    Сообщить("    Шаг 4: Обновляет версию в Ext/ObjectModule.bsl в плагинах (СериализаторMXL)");
    Сообщить("    Шаг 5: Обновляет версию в packagedef");
    Сообщить("    Шаг 6: Обновляет версию в <Synonym> файлов Configuration.xml");
    Сообщить(" ");
    Сообщить("Примеры:");
    Сообщить("    set-version.os 1.2.3");
    
КонецПроцедуры

Функция ФорматВерсии()
    
    // Semantic Versioning: W.X.Y или W.X.Y.Z
    // Только цифры.
    // Выражение должно быть без захватывающих групп.
    Возврат "\d+\.\d+\.\d+(?:\.\d+)?";

КонецФункции

Процедура ПроверитьФорматВерсии(Знач Версия)
    
    Регулярка = Новый РегулярноеВыражение(ФорматВерсии());
    
    Если НЕ Регулярка.Совпадает(Версия) Тогда
        ВызватьИсключение 
            "Неверный формат версии: " + Версия + Символы.ПС
            + "Ожидается формат: W.X.Y или W.X.Y.Z (например: 1.0.0, 6.9.6, 7.0.0.1)";
    КонецЕсли;
    
КонецПроцедуры

Процедура ВыполнитьОбновление(Знач НоваяВерсия)
    
    Лог.Информация("1: Обновление версии в epf/ (bddRunner, xddTestRunner)");
    
    УстановитьВерсиюВ1С(НоваяВерсия, "epf", Истина);
    
    Лог.Информация("2: Обновление версии в lib/cf (XML конфигурации)");
    
    УстановитьВерсиюВ1С(НоваяВерсия, "lib/cf");
    
    Лог.Информация("3: Обновление версии в lib/cfe (XML расширений)");
        
    УстановитьВерсиюВ1С(НоваяВерсия, "lib/cfe");
    
    Лог.Информация("4: Обновление версии в плагинах (СериализаторMXL)");
        
    УстановитьВерсиюВ1С(НоваяВерсия, "plugins/СериализаторMXL", Истина);

    Лог.Информация("5: Обновление версии в packagedef");
    
    ОбновитьPackagedef(НоваяВерсия);
    
    Лог.Информация("6: Обновление синонимов в Configuration.xml");
    
    ОбновитьСинонимы(НоваяВерсия);    

КонецПроцедуры

Процедура ОбновитьPackagedef(Знач НоваяВерсия)
    
    ПутьКФайлу = "packagedef";
    
    ФайлПроверки = Новый Файл(ПутьКФайлу);
    Если НЕ ФайлПроверки.Существует() Тогда
        ВызватьИсключение "Файл packagedef не найден по пути: " + ПутьКФайлу;
    КонецЕсли;

    ТекстовыйДокумент = Новый ТекстовыйДокумент;
    ТекстовыйДокумент.Прочитать(ПутьКФайлу, "UTF-8");
    
    Содержимое = ТекстовыйДокумент.ПолучитьТекст();
    
    ШаблонСтрокиСВерсией = "ВерсияПакета = ""%1"";";

    ШаблонПоиска = СтрШаблон(ШаблонСтрокиСВерсией, ФорматВерсии());  
    Регулярка = Новый РегулярноеВыражение(ШаблонПоиска);
    
    Если НЕ Регулярка.Совпадает(Содержимое) Тогда
        ВызватьИсключение "Не найдена строка версии в packagedef";
    КонецЕсли;

    НоваяСтрока = СтрШаблон(ШаблонСтрокиСВерсией, НоваяВерсия);
    Содержимое = Регулярка.Заменить(Содержимое, НоваяСтрока);
    
    ТекстовыйДокумент.УстановитьТекст(Содержимое);
    ТекстовыйДокумент.Записать(ПутьКФайлу, "UTF-8");
    
КонецПроцедуры

Процедура ОбновитьСинонимы(Знач НоваяВерсия)
    
    ФайлыДляОбновления = Новый Массив;
    ФайлыДляОбновления.Добавить("lib/CF/83/Configuration.xml");
    ФайлыДляОбновления.Добавить("lib/CF/83NoSync/Configuration.xml");
    ФайлыДляОбновления.Добавить("lib/CF/83xdd/Configuration.xml");
    ФайлыДляОбновления.Добавить("lib/CF/83xddNoSync/Configuration.xml");
    
    ШаблонСинонима = СтрШаблон("(<v8:content>ADD\/[B,T]DD, ver\. )%1(<\/v8:content>)", ФорматВерсии());
    
    Для Каждого ПутьКФайлу Из ФайлыДляОбновления Цикл
        
        ФайлПроверки = Новый Файл(ПутьКФайлу);
        Если НЕ ФайлПроверки.Существует() Тогда
            ВызватьИсключение "Файл не найден по пути: " + ПутьКФайлу;
        КонецЕсли;
        
        ТекстовыйДокумент = Новый ТекстовыйДокумент;
        ТекстовыйДокумент.Прочитать(ПутьКФайлу, "UTF-8");
        
        Содержимое = ТекстовыйДокумент.ПолучитьТекст();
        
        Регулярка = Новый РегулярноеВыражение(ШаблонСинонима);
        
        Если НЕ Регулярка.Совпадает(Содержимое) Тогда
            ВызватьИсключение "Не найдена версия в синониме файла: " + ПутьКФайлу;
        КонецЕсли;
                
        ШаблонЗамены = "${1}" + НоваяВерсия + "${2}";
        Содержимое = Регулярка.Заменить(Содержимое, ШаблонЗамены);
                
        ТекстовыйДокумент.УстановитьТекст(Содержимое);
        ТекстовыйДокумент.Записать(ПутьКФайлу, "UTF-8");
    
        Лог.Информация("Обновлен синоним в: " + ПутьКФайлу);
    
    КонецЦикла;
    
КонецПроцедуры

Процедура УстановитьВерсиюВ1С(Знач Версия, Знач Каталог, ОбрабатыватьМодули = Ложь)

    ФлагПроверятьМодули = ?(ОбрабатыватьМодули, "--check-module", "");

    СтрокаВыполнения = СтрШаблон("vrunner set-version --src %1 %2 --new-version %3",
        Каталог, ФлагПроверятьМодули, Версия);
    
	Исходники.ИсполнитьКоманду(СтрокаВыполнения);

КонецПроцедуры

Процедура УстановитьВерсию()

    Лог = Исходники.ПолучитьЛог();
    Лог.УстановитьУровень(УровниЛога.Информация);

    Парсер = Новый ПарсерАргументовКоманднойСтроки();

    Парсер.ДобавитьПараметрФлаг("--help", "Показать эту справку");

    Парсер.ДобавитьПараметр("версия", "Версия в формате W.X.Y или W.X.Y.Z");

    Аргументы = Парсер.Разобрать(АргументыКоманднойСтроки);

    Если Аргументы["--help"] = Истина Тогда
        ВывестиСправку();
        Возврат;
    КонецЕсли;

    НоваяВерсия = Аргументы["версия"];

    Если НЕ ЗначениеЗаполнено(НоваяВерсия) Тогда
        ВызватьИсключение "Версия не указана. Используйте: set-version.os <версия>";
    КонецЕсли;

    ПроверитьФорматВерсии(НоваяВерсия);

    Лог.Информация(СтрШаблон("Устанавливаем версию: %1", НоваяВерсия));

    ВыполнитьОбновление(НоваяВерсия);

    Лог.Информация(СтрШаблон("Установка версии: %1 успешно завершена", НоваяВерсия));

КонецПроцедуры

УстановитьВерсию();